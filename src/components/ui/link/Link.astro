---
import type { HTMLAttributes } from "astro/types";
import "./link.css";

type Variant = "body" | "nav" | "caret";
type Layout = "inline" | "stack";

type Props = Omit<HTMLAttributes<"a">, "href"> & {
  href: string;
  variant?: Variant;
  layout?: Layout;
  icon?: string;
};

const {
  href,
  variant = "body",
  layout = "inline",
  icon,
  class: className,
  ...rest
} = Astro.props;

const variantClass = {
  body: "link",
  nav: "link-nav",
  caret: "caret-link",
}[variant];

const hasIconSlot = Astro.slots.has("icon");
const hasIcon = hasIconSlot || Boolean(icon);
---

{
  hasIcon ? (
    <a
      href={href}
      class:list={[
        "link-hit",
        layout === "stack" && "link-hit-stack",
        className,
      ]}
      {...rest}
    >
      <span class={variantClass}>
        <slot />
      </span>
      <span class="link-hit-mark" aria-hidden="true">
        {hasIconSlot ? <slot name="icon" /> : icon}
      </span>
    </a>
  ) : (
    <a href={href} class:list={[variantClass, className]} {...rest}>
      <slot />
    </a>
  )
}
