---
import Link from "@/components/ui/link/Link.astro";
import Text from "@/components/ui/text/Text.astro";

interface Props {
  name: string;
  intro: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const { name, intro, ctaHref = "#work", ctaLabel = "View work" } = Astro.props;

const names = name.split(" ");
---

<section class="flex min-h-dvh flex-wrap content-stretch gap-px bg-border">
  <div
    class="@container flex min-w-[min(100%,min-content)] flex-[1_1_36rem] items-center bg-bg px-6 py-16 md:px-10 lg:px-14"
  >
    <Text variant="hero-title" class="w-full">
      {names.map((part) => <span class="block whitespace-nowrap">{part}</span>)}
    </Text>
  </div>

  <div
    class="flex min-w-[min(100%,20rem)] flex-[1.4_1_26rem] flex-col bg-bg px-6 pb-8 pt-10 md:py-16 md:pl-6 md:pr-10 lg:pl-8 lg:pr-12"
  >
    <Text variant="lede" muted class="my-auto max-w-2xl">
      {intro.split("\n").map((line) => <span class="block">{line}</span>)}
    </Text>
    <!-- TODO: Add cta link back in once we have a page to link to -->
    <!-- <Link href={ctaHref} icon="↓" layout="stack" class="mt-12 text-sm md:mt-0">
      {ctaLabel}
    </Link> -->
  </div>
</section>
