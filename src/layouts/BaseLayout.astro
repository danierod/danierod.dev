---
import { Font } from "astro:assets";
import { site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title
  ? `${title} · ${site.name}`
  : `${site.name} · ${site.tagline}`;
const canonicalHref = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalHref} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-fira-code" preload />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main id="main">
      <slot />
    </main>
    <script>
      const skipTab = "button, input, select, textarea, summary, pre";
      for (const el of document.querySelectorAll<HTMLElement>(skipTab)) {
        el.tabIndex = -1;
      }

      for (const el of document.querySelectorAll<HTMLElement>("*")) {
        if (el instanceof HTMLAnchorElement) continue;
        const { overflow, overflowX, overflowY } = getComputedStyle(el);
        const scrollable = [overflow, overflowX, overflowY].some(
          (value) => value === "auto" || value === "scroll",
        );
        if (scrollable) el.tabIndex = -1;
      }
    </script>
  </body>
</html>
